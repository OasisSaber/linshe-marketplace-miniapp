.offer-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-4);
}

.offer-label,
.offer-price-label {
  color: var(--color-muted);
  font-size: 24rpx;
}

.offer-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.offer-price {
  color: var(--color-brand-text);
  font-size: 44rpx;
  font-weight: 800;
}

.offer-control {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.offer-control__prefix {
  font-size: 32rpx;
  font-weight: 800;
}

.offer-control__input {
  flex: 1;
  min-height: var(--touch-min);
  font-size: 36rpx;
  font-weight: 800;
}
