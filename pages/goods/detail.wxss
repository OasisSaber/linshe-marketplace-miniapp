.detail-page > view {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.detail-gallery {
  overflow: hidden;
}

.detail-gallery__image,
.detail-gallery__placeholder {
  width: 100%;
  height: 600rpx;
}

.detail-gallery__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 96rpx;
}

.detail-summary,
.meetup-card {
  padding: var(--space-4);
}

.detail-summary__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.detail-price {
  color: var(--color-brand-text);
  font-size: 48rpx;
  font-weight: 800;
}

.detail-title {
  display: block;
  margin-top: var(--space-2);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-meta {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-muted);
  font-size: 24rpx;
}

.detail-description {
  display: block;
  margin-top: var(--space-3);
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.65;
}

.seller-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 120rpx;
  padding: var(--space-3) var(--space-4);
}

.seller-row__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: 30rpx;
  font-weight: 800;
}

.seller-row__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.seller-row__name {
  font-size: 28rpx;
  font-weight: 800;
}

.seller-row__meta,
.meetup-card__helper {
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.seller-row__action {
  color: var(--color-brand-text);
  font-size: 25rpx;
  font-weight: 700;
}

.meetup-card__label {
  display: block;
  color: var(--color-muted);
  font-size: 23rpx;
}

.meetup-card__value {
  display: block;
  margin-top: var(--space-1);
  font-size: 29rpx;
  font-weight: 800;
}

.meetup-card__helper {
  display: block;
  margin-top: var(--space-2);
}

.detail-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
}

.detail-actions .button-primary {
  grid-column: 1 / -1;
}


.availability-banner {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3) var(--space-4);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
}

.availability-banner--warning {
  border-color: var(--color-warning-border);
  background: var(--color-warning-soft);
}

.availability-banner--neutral {
  background: var(--color-surface-subtle);
}

.availability-banner__title {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.availability-banner__description {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}
