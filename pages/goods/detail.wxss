
.detail-ready {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.detail-gallery {
  overflow: hidden;
  border-radius: var(--radius-large);
}

.detail-gallery__image,
.detail-gallery__placeholder {
  width: 100%;
  height: 620rpx;
}

.detail-gallery__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 96rpx;
}

.detail-summary {
  padding: var(--space-4);
}

.detail-eyebrow {
  display: block;
  margin-bottom: var(--space-2);
  color: var(--color-brand-text);
  font-size: var(--font-footnote);
  font-weight: 600;
  line-height: 1.35;
}

.detail-summary__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.detail-price {
  color: var(--color-text);
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.detail-title {
  display: block;
  margin-top: var(--space-2);
  font-size: var(--font-title-2);
  font-weight: 700;
  line-height: 1.28;
}

.detail-meta {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.4;
}

.detail-description {
  display: block;
  margin-top: var(--space-3);
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.65;
}

.seller-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 120rpx;
  padding: var(--space-3) var(--space-4);
}

.seller-row__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: var(--font-callout);
  font-weight: 700;
}

.seller-row__copy,
.meetup-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.seller-row__name {
  font-size: var(--font-body);
  font-weight: 700;
}

.seller-row__meta,
.meetup-card__helper {
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.45;
}

.seller-row__action {
  color: var(--color-brand-text);
  font-size: 26rpx;
  font-weight: 600;
}

.availability-banner--warning {
  border-color: var(--color-warning-border);
  background: var(--color-warning-soft);
}

.availability-banner--neutral {
  background: var(--color-surface-subtle);
}

.meetup-card {
  padding: var(--space-4);
}

.meetup-card__row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.meetup-card__label {
  color: var(--color-muted);
  font-size: var(--font-footnote);
}

.meetup-card__value {
  color: var(--color-text);
  font-size: var(--font-callout);
  font-weight: 700;
}

.meetup-card__helper {
  display: block;
  margin-top: var(--space-3);
}

.detail-bottom-spacer {
  height: 132rpx;
}

.detail-actions {
  display: grid;
  grid-template-columns: 104rpx 104rpx 1fr;
  gap: var(--space-2);
}

.detail-actions__secondary,
.detail-actions__primary {
  width: 100%;
}

.detail-actions__secondary {
  padding: 0 var(--space-1);
  font-size: 25rpx;
}
