
<view class="page detail-page">
  <view wx:if="{{state === 'ready'}}" class="detail-ready">
    <view class="detail-gallery surface-card">
      <image wx:if="{{item.images[0].src}}" class="detail-gallery__image image-outline" src="{{item.images[0].src}}" mode="aspectFill" />
      <view wx:else class="detail-gallery__placeholder">{{item.images[0].emoji}}</view>
    </view>

    <view class="detail-summary surface-card">
      <text class="detail-eyebrow">校内闲置 · {{item.condition}}</text>
      <view class="detail-summary__top">
        <text class="detail-price money">¥{{item.price}}</text>
        <text class="status-chip">{{statusLabel}}</text>
      </view>
      <text class="detail-title">{{item.title}}</text>
      <text class="detail-meta">原价 ¥{{item.original_price}} · {{item.campus_location}}</text>
      <text class="detail-description">{{item.description}}</text>
    </view>

    <view
      class="seller-row inset-group pressable"
      hover-class="pressable--active"
      bindtap="openSeller"
      aria-label="查看卖家资料"
      role="button"
    >
      <view class="seller-row__avatar">{{seller ? seller.avatar_text : '卖'}}</view>
      <view class="seller-row__copy">
        <text class="seller-row__name">{{seller ? seller.name : '卖家资料'}}</text>
        <text class="seller-row__meta">{{seller ? seller.campus + ' · 信誉分 ' + seller.reputation_score : '资料暂不可用'}}</text>
      </view>
      <text class="seller-row__action">查看</text>
    </view>

    <view
      wx:if="{{item.status !== 'on_sale'}}"
      class="feedback-banner availability-banner--{{availability.tone}}"
      role="status"
    >
      <text class="feedback-banner__title">{{availability.title}}</text>
      <text class="feedback-banner__description">{{availability.description}}</text>
    </view>

    <view class="meetup-card inset-group">
      <view class="meetup-card__row">
        <view class="meetup-card__copy">
          <text class="meetup-card__label">建议面交地点</text>
          <text class="meetup-card__value">{{item.campus_location}}</text>
        </view>
        <text class="status-chip">校内面交</text>
      </view>
      <text class="meetup-card__helper">请在公共区域当面检查商品。当前支付与核销仅用于本地 Demo。</text>
    </view>

    <view class="detail-bottom-spacer"></view>

    <view class="bottom-action-bar detail-actions">
      <button
        class="button-base button-secondary pressable detail-actions__secondary"
        hover-class="pressable--active"
        bindtap="toggleFavorite"
        aria-label="{{favorited ? '取消收藏商品' : '收藏商品'}}"
      >{{favorited ? '已收藏' : '收藏'}}</button>
      <button
        class="button-base button-secondary pressable detail-actions__secondary"
        hover-class="pressable--active"
        bindtap="chatSeller"
        aria-label="联系卖家"
      >联系</button>
      <button
        class="button-base button-primary pressable detail-actions__primary"
        hover-class="pressable--active"
        bindtap="makeOffer"
        disabled="{{item.status !== 'on_sale'}}"
        aria-label="{{availability.primaryActionLabel}}"
      >{{availability.primaryActionLabel}}</button>
    </view>
  </view>

  <view wx:elif="{{state === 'not-found'}}" class="state-panel">
    <text class="state-panel__title">商品不存在</text>
    <text class="state-panel__description">链接可能已失效，且不会回退到其他商品。</text>
    <button class="button-base button-secondary pressable" hover-class="pressable--active" bindtap="goBack">返回上一页</button>
  </view>
</view>
