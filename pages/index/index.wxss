
.home-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.home-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-1) 0;
}

.home-eyebrow {
  display: block;
  color: var(--color-brand-text);
  font-size: var(--font-footnote);
  font-weight: 600;
}

.home-title {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--font-large-title);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.home-count {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.home-count__value {
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
}

.home-count__label {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.home-search {
  display: flex;
  align-items: center;
  min-height: var(--touch-min);
  padding-left: var(--space-3);
  overflow: hidden;
  border-radius: var(--radius-control);
  background: var(--color-surface-subtle);
  box-shadow: none;
}

.home-search__input {
  flex: 1;
  height: var(--touch-min);
  font-size: var(--font-body);
}

.home-search__button {
  width: 120rpx;
  height: var(--touch-min);
  color: var(--color-brand-text);
  font-size: 26rpx;
  font-weight: 600;
}

.home-categories {
  width: 100%;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: var(--space-2);
  padding-right: var(--space-4);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

.product-card {
  position: relative;
  overflow: hidden;
}

.product-card__main {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.product-card__image,
.product-card__placeholder {
  width: 100%;
  height: 284rpx;
}

.product-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 64rpx;
}

.product-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: var(--space-3);
}

.product-card__title {
  display: -webkit-box;
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-card__meta {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.4;
}

.product-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-1);
  margin-top: var(--space-3);
}

.product-card__price {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
}

.product-card__favorite {
  width: 100%;
  min-height: var(--touch-min);
  border-top: 1rpx solid var(--color-border);
  border-radius: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-footnote);
  font-weight: 600;
}

.product-card__favorite--active {
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
}
