<view class="page">
  <scroll-view class="content" scroll-y>
    <view class="warning-card">
      <view class="warn-icon">▣</view>
      <view>
        <view class="warn-title">校园防骗指南</view>
        <view class="warn-text">切勿脱离平台私下转账，坚持当面验货、面对面交易，谨防“低价代付”陷阱。</view>
      </view>
    </view>

    <view class="section-title">校内推荐交易点</view>
    <view class="list-card">
      <view wx:for="{{locations}}" wx:key="title" class="safe-row">
        <view class="row-icon green">{{item.icon}}</view>
        <view class="row-main">
          <view>{{item.title}}</view>
          <text>⌖ {{item.desc}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="section-title">安全知识</view>
    <view class="list-card">
      <view wx:for="{{guides}}" wx:key="*this" class="safe-row">
        <view class="row-icon gray">□</view>
        <view class="row-main single">{{item}}</view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="report-row" bindtap="report">
      <view class="row-icon red">⚑</view>
      <text>举报与反馈</text>
      <text class="arrow">›</text>
    </view>
  </scroll-view>
</view>
