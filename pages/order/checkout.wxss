
.checkout-ready {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.checkout-heading {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-1) 0;
}

.checkout-heading__eyebrow {
  color: var(--color-brand-text);
  font-size: var(--font-footnote);
  font-weight: 600;
}

.checkout-heading__title {
  font-size: var(--font-large-title);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.checkout-heading__description {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.5;
}

.checkout-item {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
}

.checkout-item__image,
.checkout-item__placeholder {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-sm);
}

.checkout-item__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 48rpx;
}

.checkout-item__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.checkout-item__title {
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.4;
}

.checkout-item__meta,
.checkout-helper {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.45;
}

.checkout-section {
  padding: 0 var(--space-4);
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.fee-row + .fee-row {
  border-top: 1rpx solid var(--color-border);
}

.fee-row--discount {
  color: var(--color-brand-text);
}

.fee-row--total {
  color: var(--color-text);
  font-size: var(--font-callout);
  font-weight: 700;
}

.checkout-location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) 0;
}

.checkout-location-label {
  display: block;
  color: var(--color-muted);
  font-size: var(--font-footnote);
}

.checkout-location {
  display: block;
  margin-top: var(--space-1);
  font-size: var(--font-callout);
  font-weight: 700;
}

.checkout-helper {
  display: block;
  margin: 0;
  padding: 0 0 var(--space-3);
}

.checkout-bottom-spacer {
  height: 136rpx;
}

.checkout-submit-bar {
  display: grid;
  grid-template-columns: auto minmax(260rpx, 1fr);
  align-items: center;
  gap: var(--space-3);
}

.checkout-submit-bar__total {
  display: flex;
  flex-direction: column;
  min-width: 132rpx;
}

.checkout-submit-bar__label {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.checkout-submit-bar__amount {
  margin-top: var(--space-1);
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
}

.checkout-submit {
  width: 100%;
}
