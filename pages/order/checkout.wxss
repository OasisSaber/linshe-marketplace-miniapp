.checkout-page > view {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.checkout-item {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
}

.checkout-item__image,
.checkout-item__placeholder {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-sm);
}

.checkout-item__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 48rpx;
}

.checkout-item__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.checkout-item__title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.checkout-item__meta,
.checkout-helper {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.checkout-section {
  padding: var(--space-4);
}

.checkout-section__title {
  display: block;
  margin-bottom: var(--space-3);
  font-size: 30rpx;
  font-weight: 800;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.fee-row--discount {
  color: var(--color-brand-text);
}

.fee-row--total {
  margin-top: var(--space-2);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.checkout-location {
  font-size: 28rpx;
  font-weight: 700;
}

.checkout-error {
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-danger);
  background: var(--color-danger-soft);
  font-size: 26rpx;
}

.checkout-submit {
  width: 100%;
}
