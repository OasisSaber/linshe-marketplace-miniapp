.page {
  min-height: 100vh;
  padding: 0 28rpx 32rpx;
  box-sizing: border-box;
  background: var(--color-bg);
  color: var(--color-text);
}

.status-hero {
  display: flex;
  align-items: center;
  margin: 0 -28rpx 24rpx;
  padding: 34rpx 36rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-dark));
}

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  font-size: 42rpx;
}

.status-title,
.status-sub,
.card-title,
.timeline-title,
.timeline-time,
.meta,
.qr-text,
.qr-sub,
.place,
.valid {
  display: block;
}

.status-title {
  font-size: 34rpx;
  font-weight: 900;
}

.status-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 25rpx;
}

.timeline,
.location-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
}

.card-title {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.timeline-row {
  position: relative;
  display: flex;
  gap: 22rpx;
  padding-bottom: 26rpx;
}

.timeline-row::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 28rpx;
  width: 2rpx;
  height: calc(100% - 18rpx);
  background: var(--color-border);
}

.timeline-row:last-child::before {
  display: none;
}

.dot {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--color-border);
  border-radius: 50%;
  background: #fff;
}

.timeline-row.done .dot,
.timeline-row.current .dot {
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.timeline-title {
  font-size: 27rpx;
  font-weight: 800;
}

.timeline-time {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 23rpx;
}

.map {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 180rpx;
  margin-bottom: 18rpx;
  border-radius: var(--radius-sm);
  color: var(--color-muted);
  background: repeating-linear-gradient(90deg, #e5e7eb 0 34rpx, #f3f4f6 34rpx 68rpx);
  font-size: 22rpx;
  font-weight: 800;
}

.place {
  font-size: 28rpx;
  font-weight: 900;
}

.meta {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  margin: 22rpx 0;
  padding: 30rpx;
}

.qr-text {
  font-size: 38rpx;
  font-weight: 900;
}

.qr-sub {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.qr-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin-top: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  background: #fff;
  color: var(--color-text);
  font-size: 120rpx;
  box-shadow: 0 8rpx 22rpx rgba(18, 19, 24, 0.08);
}

.valid {
  margin-top: 18rpx;
  color: var(--color-brand);
  font-size: 24rpx;
  font-weight: 800;
}

.bottom-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.contact,
.confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 84rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.contact {
  color: var(--color-text);
  background: #fff;
  border: 1rpx solid var(--color-border);
}

.confirm {
  color: #fff;
  background: var(--color-brand);
}
