.order-page > view {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.order-status,
.order-item,
.timeline,
.snapshot {
  padding: var(--space-4);
}

.order-status {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.order-status__label,
.order-status__id {
  color: var(--color-muted);
  font-size: 23rpx;
}

.order-status__value {
  color: var(--color-brand-text);
  font-size: 36rpx;
  font-weight: 800;
}

.order-item {
  display: flex;
  gap: var(--space-3);
}

.order-item__image,
.order-item__placeholder {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-sm);
}

.order-item__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 48rpx;
}

.order-item__copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.order-item__title {
  font-size: 28rpx;
  font-weight: 800;
}

.order-item__price {
  color: var(--color-brand-text);
  font-size: 28rpx;
  font-weight: 800;
}

.order-item__location {
  color: var(--color-muted);
  font-size: 24rpx;
}

.timeline__title,
.snapshot__title {
  display: block;
  margin-bottom: var(--space-3);
  font-size: 30rpx;
  font-weight: 800;
}

.timeline-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 64rpx;
}

.timeline-row__mark {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 10rpx;
}

.timeline-row__mark--done {
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.timeline-row__mark--current {
  border-color: var(--color-brand);
  box-shadow: 0 0 0 8rpx var(--color-brand-soft);
}

.timeline-row__title {
  font-size: 26rpx;
}

.snapshot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.snapshot-row--total {
  margin-top: var(--space-2);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
  color: var(--color-text);
  font-weight: 800;
}

.order-error {
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-danger);
  background: var(--color-danger-soft);
  font-size: 26rpx;
}

.order-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
