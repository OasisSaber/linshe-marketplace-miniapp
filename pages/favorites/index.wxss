
.favorites-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.favorites-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-1) 0;
}

.favorites-header__eyebrow {
  color: var(--color-brand-text);
  font-size: var(--font-footnote);
  font-weight: 600;
}

.favorites-header__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
}

.favorites-header__title {
  font-size: var(--font-large-title);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

.favorites-header__description {
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.45;
}

.favorites-header__count {
  color: var(--color-brand-text);
  font-size: var(--font-body);
  font-weight: 700;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.favorite-card {
  overflow: hidden;
}

.favorite-card__main {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
}

.favorite-card__image,
.favorite-card__placeholder {
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--radius-sm);
}

.favorite-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 52rpx;
}

.favorite-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.favorite-card__title {
  display: -webkit-box;
  overflow: hidden;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.favorite-card__meta {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.4;
}

.favorite-card__price {
  margin-top: auto;
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
}

.favorite-card__remove {
  width: 100%;
  min-height: var(--touch-min);
  border-top: 1rpx solid var(--color-border);
  border-radius: 0;
  font-size: 25rpx;
}
