.favorites-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.favorites-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-3);
}

.favorites-header__title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.favorites-header__description {
  display: block;
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: 24rpx;
}

.favorites-header__count {
  color: var(--color-brand-text);
  font-size: 26rpx;
  font-weight: 800;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.favorite-card {
  overflow: hidden;
}

.favorite-card__main {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
}

.favorite-card__image,
.favorite-card__placeholder {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
}

.favorite-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 52rpx;
}

.favorite-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.favorite-card__title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.favorite-card__meta {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: 23rpx;
}

.favorite-card__price {
  margin-top: auto;
  color: var(--color-brand-text);
  font-size: 32rpx;
  font-weight: 800;
}

.favorite-card__remove {
  width: 100%;
  min-height: var(--touch-min);
  border-top: 1rpx solid var(--color-border);
  border-radius: 0;
  color: var(--color-danger);
  font-size: 25rpx;
}


.favorites-error {
  display: block;
  margin-bottom: var(--space-3);
  padding: var(--space-2) var(--space-3);
  border: 1rpx solid var(--color-danger);
  border-radius: var(--radius-sm);
  color: var(--color-danger);
  background: var(--color-danger-soft);
  font-size: 24rpx;
  line-height: 1.5;
}
