@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
}

.tabs {
  display: flex;
  gap: 44rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.tabs view {
  position: relative;
  padding: 18rpx 0 16rpx;
  color: var(--color-muted);
  font-size: 28rpx;
}

.tabs .active {
  color: var(--color-text);
  font-weight: 900;
}

.tabs .active::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-brand);
}

.list {
  height: calc(100vh - 72rpx);
}

.fav-card {
  display: flex;
  gap: 22rpx;
  margin: 22rpx 28rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}

.thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border-radius: 22rpx;
  background: #f0fdf4;
  text-align: center;
  line-height: 1;
  font-size: 60rpx;
}

.main {
  flex: 1;
  min-width: 0;
}

.title {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 27rpx;
  font-weight: 800;
}

.meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.drop {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #fee2e2;
  color: #dc2626;
  font-weight: 800;
}

.bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 18rpx;
}

.price {
  color: var(--color-brand);
  font-size: 30rpx;
  font-weight: 900;
}

.original {
  margin-left: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  text-decoration: line-through;
}

.bottom button {
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 999rpx;
  background: #edeef2;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1;
}
