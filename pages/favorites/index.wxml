<view class="page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="{{activeTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="setTab">{{item}}</view>
  </view>

  <scroll-view class="list" scroll-y>
    <view wx:if="{{items.length}}" wx:for="{{items}}" wx:key="id" class="fav-card" data-id="{{item.item_id}}" bindtap="openDetail">
      <view class="thumb">
        <text wx:if="{{!item.src}}">{{item.emoji}}</text>
        <image wx:else class="thumb-img" src="{{item.src}}" mode="aspectFill"></image>
      </view>
      <view class="main">
        <view class="title">{{item.title}}</view>
        <view class="meta">
          <text wx:if="{{item.tag}}" class="drop">{{item.tag}}</text>
          <text>{{item.location}}</text>
        </view>
        <view class="bottom">
          <view>
            <text class="price">¥{{item.price}}</text>
            <text wx:if="{{item.originalPrice}}" class="original">¥{{item.originalPrice}}</text>
          </view>
          <button catchtap="removeFavorite">♥ 取消收藏</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!items.length}}" class="empty">
      <image class="empty-img" src="/images/empty/empty-fav.png" mode="aspectFit"></image>
      <text class="empty-title">还没有收藏</text>
      <text class="empty-desc">看到心仪好物，点 ♥ 收藏起来</text>
      <button class="empty-btn" bindtap="goShopping">去逛逛</button>
    </view>
  </scroll-view>
</view>
