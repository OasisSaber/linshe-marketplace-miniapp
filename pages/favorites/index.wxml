<view class="page favorites-page">
  <view class="favorites-header">
    <view>
      <text class="favorites-header__title">我的收藏</text>
      <text class="favorites-header__description">收藏状态在首页、详情和个人中心同步</text>
    </view>
    <text class="favorites-header__count tabular-nums">{{items.length}} 件</text>
  </view>

  <text wx:if="{{errorMessage}}" class="favorites-error" role="alert">{{errorMessage}}</text>

  <view wx:if="{{items.length}}" class="favorite-list">
    <view wx:for="{{items}}" wx:key="item_id" class="favorite-card surface-card">
      <view
        class="favorite-card__main pressable"
        hover-class="pressable--active"
        data-id="{{item.item_id}}"
        bindtap="openDetail"
        aria-label="查看 {{item.title}}"
       role="button">
        <image wx:if="{{item.images[0].src}}" class="favorite-card__image image-outline" src="{{item.images[0].src}}" mode="aspectFill" />
        <view wx:else class="favorite-card__placeholder">{{item.images[0].emoji}}</view>
        <view class="favorite-card__copy">
          <text class="favorite-card__title">{{item.title}}</text>
          <text class="favorite-card__meta">{{item.condition}} · {{item.campus_location}}</text>
          <text class="favorite-card__price money">¥{{item.price}}</text>
        </view>
      </view>
      <button
        class="favorite-card__remove button-base button-ghost pressable"
        hover-class="pressable--active"
        data-id="{{item.item_id}}"
        bindtap="removeFavorite"
        disabled="{{removingId === item.item_id}}"
        aria-label="取消收藏 {{item.title}}"
      >{{removingId === item.item_id ? '处理中…' : '取消收藏'}}</button>
    </view>
  </view>

  <view wx:else class="state-panel">
    <text class="state-panel__title">还没有收藏商品</text>
    <text class="state-panel__description">在首页或商品详情点击收藏后，会统一出现在这里。</text>
    <button class="button-base button-primary pressable" hover-class="pressable--active" bindtap="goShopping">去逛逛</button>
  </view>
</view>
