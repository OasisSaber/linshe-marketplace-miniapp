@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
}

.search-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  border-radius: 24rpx;
  background: #edeef2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
}

.search-text {
  font-size: 26rpx;
  font-weight: 600;
}

.clear {
  color: var(--color-muted);
  font-size: 30rpx;
}

.filter-scroll {
  white-space: nowrap;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 28rpx;
}

.filter-chip {
  flex: 0 0 auto;
  margin: 0;
  padding: 12rpx 26rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.2;
}

.filter-chip.active {
  border-color: var(--color-brand);
  background: var(--color-brand);
  color: #ffffff;
  font-weight: 700;
}

.result-count {
  padding: 18rpx 28rpx 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.result-count text {
  color: var(--color-text);
  font-weight: 800;
}

.result-scroll {
  height: calc(100vh - 194rpx);
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 12rpx 28rpx 32rpx;
}

.result-card {
  width: calc((100% - 20rpx) / 2);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.cover {
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover text {
  font-size: 72rpx;
}

.cover-yellow { background: #fef9c3; }
.cover-red { background: #fee2e2; }
.cover-purple { background: #ede9fe; }
.cover-green { background: #d1fae5; }
.cover-blue { background: #dbeafe; }
.cover-pink { background: #fce7f3; }

.card-body {
  padding: 16rpx 18rpx 18rpx;
}

.price {
  color: var(--color-brand);
  font-size: 28rpx;
  font-weight: 900;
}

.title {
  height: 64rpx;
  margin-top: 6rpx;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.condition {
  display: inline-block;
  margin-top: 12rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
  color: #15803d;
  font-size: 20rpx;
  font-weight: 700;
}

.meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.seller {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-dark));
  color: #ffffff;
  text-align: center;
  line-height: 1;
  font-size: 18rpx;
  font-weight: 900;
}
