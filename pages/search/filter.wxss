
.search-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.search-control {
  display: flex;
  align-items: center;
  min-height: var(--touch-min);
  padding-left: var(--space-3);
  overflow: hidden;
  border-radius: var(--radius-control);
  background: var(--color-surface-subtle);
  box-shadow: none;
}

.search-control__input {
  flex: 1;
  height: var(--touch-min);
  font-size: var(--font-body);
}

.search-control__clear {
  width: 112rpx;
  height: var(--touch-min);
  color: var(--color-brand-text);
  font-size: 26rpx;
  font-weight: 600;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: var(--space-2);
  padding-right: var(--space-4);
}

.filter-panel {
  padding: var(--space-3);
}

.sort-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-2);
  padding: 6rpx;
  border-radius: var(--radius-control);
  background: var(--color-surface-subtle);
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-min);
  border-radius: 16rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.sort-option--active {
  color: var(--color-text);
  background: var(--color-surface);
  box-shadow: var(--shadow-float);
}

.meetup-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--color-border);
}

.meetup-toggle__title {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
}

.meetup-toggle__description {
  display: block;
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: var(--font-footnote);
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-header__title {
  font-size: var(--font-title-3);
  font-weight: 700;
}

.result-header__count {
  color: var(--color-muted);
  font-size: var(--font-footnote);
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.result-card {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-3);
}

.result-card__image,
.result-card__placeholder {
  flex: none;
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--radius-sm);
}

.result-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 56rpx;
}

.result-card__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.result-card__title {
  display: -webkit-box;
  overflow: hidden;
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.result-card__meta {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.45;
}

.result-card__bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-2);
  margin-top: auto;
}

.result-card__price {
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
}
