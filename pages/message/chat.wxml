<view class="chat-page">
  <view wx:if="{{state === 'ready'}}" class="chat-shell">
    <view class="chat-header surface-card">
      <view class="chat-avatar">{{peer.avatar}}</view>
      <view class="chat-peer">
        <text class="chat-peer__name">{{peer.name}}</text>
        <text class="chat-peer__status">{{peer.status}}</text>
      </view>
    </view>

    <view class="chat-product surface-card">
      <text class="chat-product__title">{{item.title}}</text>
      <text class="chat-product__price money">¥{{item.price}}</text>
      <view class="chat-product__actions">
        <button class="button-base button-secondary pressable" hover-class="pressable--active" bindtap="openOffer">出价</button>
        <button class="button-base button-primary pressable" hover-class="pressable--active" bindtap="buyNow">直接购买</button>
      </view>
    </view>

    <scroll-view class="message-list" scroll-y scroll-with-animation>
      <view wx:for="{{messages}}" wx:key="id" class="message-row message-row--{{item.side}}">
        <text class="message-bubble">{{item.text}}</text>
      </view>
    </scroll-view>

    <text wx:if="{{errorMessage}}" class="chat-error">{{errorMessage}}</text>

    <view class="chat-composer">
      <input
        class="chat-composer__input"
        value="{{draft}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendMessage"
        placeholder="输入消息"
        aria-label="输入聊天消息"
      />
      <button class="chat-composer__send button-primary pressable" hover-class="pressable--active" bindtap="sendMessage">发送</button>
    </view>
  </view>

  <view wx:elif="{{state === 'not-found'}}" class="state-panel">
    <text class="state-panel__title">会话不存在</text>
    <text class="state-panel__description">无效会话不会再读取或修改默认会话。</text>
    <button class="button-base button-secondary pressable" hover-class="pressable--active" bindtap="goBack">返回上一页</button>
  </view>
</view>
