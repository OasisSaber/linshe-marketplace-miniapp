.chat-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4) calc(128rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.chat-shell {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.chat-header,
.chat-product {
  padding: var(--space-3);
}

.chat-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.chat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: 30rpx;
  font-weight: 800;
}

.chat-peer {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.chat-peer__name,
.chat-product__title {
  font-size: 28rpx;
  font-weight: 800;
}

.chat-peer__status {
  color: var(--color-muted);
  font-size: 23rpx;
}

.chat-product {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--space-2);
}

.chat-product__price {
  color: var(--color-brand-text);
  font-size: 30rpx;
  font-weight: 800;
}

.chat-product__actions {
  display: grid;
  grid-column: 1 / -1;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2);
}

.message-list {
  height: 700rpx;
}

.message-row {
  display: flex;
  margin: var(--space-2) 0;
}

.message-row--me {
  justify-content: flex-end;
}

.message-row--time {
  justify-content: center;
}

.message-bubble {
  max-width: 560rpx;
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  background: var(--color-surface);
  font-size: 27rpx;
  line-height: 1.55;
  box-shadow: var(--shadow-card);
}

.message-row--me .message-bubble {
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
}

.message-row--time .message-bubble {
  padding: var(--space-1) var(--space-2);
  color: var(--color-muted);
  background: transparent;
  font-size: 22rpx;
  box-shadow: none;
}

.chat-error {
  color: var(--color-danger);
  font-size: 24rpx;
  text-align: center;
}

.chat-composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface);
  box-shadow: var(--shadow-float);
}

.chat-composer__input {
  flex: 1;
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 27rpx;
}

.chat-composer__send {
  width: 144rpx;
  min-height: var(--touch-min);
  border-radius: var(--radius-pill);
  color: var(--color-on-brand);
  font-size: 27rpx;
  font-weight: 800;
}
