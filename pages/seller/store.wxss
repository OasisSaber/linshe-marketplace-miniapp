@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
}

.cover {
  height: 220rpx;
  background: linear-gradient(162deg, var(--color-brand), var(--color-brand-dark));
  position: relative;
}

.seller-card {
  position: relative;
  padding: 0 28rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #ffffff;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  transform: translateY(-54rpx);
  margin-bottom: -38rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(135deg, #34d399, var(--color-brand-dark));
  color: #ffffff;
  text-align: center;
  line-height: 1;
  font-size: 52rpx;
  font-weight: 900;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 900;
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: var(--color-warn);
  font-size: 20rpx;
  font-weight: 800;
}

.campus {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.stats {
  display: flex;
  margin-top: 24rpx;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: var(--color-bg);
}

.stat {
  flex: 1;
  border-right: 1rpx solid var(--color-border);
  text-align: center;
}

.stat:last-child {
  border-right: 0;
}

.stat view {
  font-size: 30rpx;
  font-weight: 900;
}

.stat view text {
  color: #f59e0b;
}

.stat > text {
  color: var(--color-muted);
  font-size: 22rpx;
}

.content {
  height: calc(100vh - 522rpx);
}

.section-title {
  padding: 26rpx 28rpx 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 28rpx 32rpx;
}

.goods-card {
  width: calc((100% - 20rpx) / 2);
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: #ffffff;
}

.goods-cover {
  height: 220rpx;
  background: #f0fdf4;
  text-align: center;
  line-height: 220rpx;
  font-size: 72rpx;
}

.goods-title {
  height: 64rpx;
  padding: 16rpx 18rpx 0;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 32rpx;
}

.goods-price {
  padding: 8rpx 18rpx 18rpx;
  color: var(--color-brand);
  font-size: 28rpx;
  font-weight: 900;
}

.bottom-bar {
  height: 116rpx;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  border-top: 1rpx solid var(--color-border);
  background: #ffffff;
}

.bottom-bar button {
  height: 84rpx;
  margin: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.ghost {
  flex: 1;
  border: 0;
  background: #edeef2;
  color: var(--color-text);
}

.primary {
  flex: 1.8;
  border: 0;
  background: var(--color-brand);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(34, 197, 94, 0.32);
}
