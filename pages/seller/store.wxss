.seller-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.seller-hero {
  display: grid;
  grid-template-columns: 104rpx 1fr auto;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
}

.seller-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: 40rpx;
  font-weight: 800;
}

.seller-identity {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.seller-name {
  font-size: 32rpx;
  font-weight: 800;
}

.seller-meta,
.seller-bio {
  margin-top: var(--space-1);
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.follow-button {
  min-width: 144rpx;
  padding: 0 var(--space-3);
}

.seller-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: var(--space-3) 0;
}

.seller-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  border-right: 1rpx solid var(--color-border);
}

.seller-stat:last-child {
  border-right: 0;
}

.seller-stat__value {
  font-size: 34rpx;
  font-weight: 800;
}

.seller-stat__label {
  color: var(--color-muted);
  font-size: 23rpx;
}

.seller-section {
  margin-top: var(--space-5);
}

.seller-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.seller-section__count {
  color: var(--color-muted);
  font-size: 24rpx;
}

.seller-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

.seller-item {
  overflow: hidden;
}

.seller-item__image,
.seller-item__placeholder {
  width: 100%;
  height: 276rpx;
}

.seller-item__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-subtle);
  font-size: 64rpx;
}

.seller-item__copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3);
}

.seller-item__title {
  display: -webkit-box;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.seller-item__price {
  color: var(--color-brand-text);
  font-size: 30rpx;
  font-weight: 800;
}
