
.publish-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.verification-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4);
  border-color: var(--color-warning-border);
  background: var(--color-warning-soft);
}

.verification-banner__copy,
.image-placeholder__copy,
.setting-row__copy,
.location-row__copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.verification-banner__title,
.image-placeholder__title,
.setting-row__title {
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.35;
}

.verification-banner__description,
.image-placeholder__description,
.setting-row__description {
  color: var(--color-muted);
  font-size: var(--font-footnote);
  line-height: 1.45;
}

.publish-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.image-placeholder {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  padding: var(--space-4);
  gap: var(--space-3);
  border-style: dashed;
  border-color: var(--color-border-strong);
  box-shadow: none;
}

.image-placeholder__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-control);
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: 40rpx;
  font-weight: 500;
}

.price-control {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.price-control__prefix {
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
}

.price-control__input {
  flex: 1;
  min-height: var(--control-large);
  font-size: var(--font-title-2);
  font-weight: 700;
}

.setting-row,
.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  min-height: 120rpx;
  padding: var(--space-3) var(--space-4);
}

.location-row__label {
  color: var(--color-muted);
  font-size: var(--font-footnote);
}

.location-row__value {
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 600;
}

.location-row__action {
  color: var(--color-brand-text);
  font-size: 26rpx;
  font-weight: 600;
}

.form-error {
  padding: var(--space-3) var(--space-4);
  border: 1rpx solid var(--color-danger-border);
  border-radius: var(--radius-card);
  color: var(--color-danger);
  background: var(--color-danger-soft);
  font-size: var(--font-body);
  line-height: 1.45;
}

.submit-button {
  width: 100%;
  min-height: var(--control-large);
}
