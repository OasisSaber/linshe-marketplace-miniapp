.notice,
.photo-row {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.notice text {
  display: block;
  margin-bottom: 20rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.5;
}

.photo-row {
  display: flex;
  gap: 16rpx;
  overflow: hidden;
}

.photo-add,
.photo-cover,
.photo-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--radius-sm);
  background: #edeef2;
  color: var(--color-muted);
  font-size: 34rpx;
}

.photo-add {
  border: 2rpx dashed var(--color-border);
}

.photo-add text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.photo-cover {
  position: relative;
  color: #fff;
  background: #0f2027;
  font-size: 60rpx;
}

.photo-cover text {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: var(--color-brand);
  font-size: 18rpx;
}

.photo-empty {
  color: var(--color-border);
  background: #f7f8fa;
  border: 1rpx dashed var(--color-border);
}

.form input,
.form textarea,
.price-input {
  height: 84rpx;
  margin-bottom: 0;
  padding: 0 22rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #fff;
  box-sizing: border-box;
  font-size: 28rpx;
}

.form textarea {
  width: 100%;
  height: 150rpx;
  padding-top: 24rpx;
}

.price-input {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.price-input input {
  flex: 1;
  border-bottom: 0;
  font-weight: 900;
}

.field {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.field-label,
.location-title,
.location-sub,
.publish-note {
  display: block;
}

.field-label {
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip,
.condition-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: var(--color-muted);
  background: #edeef2;
  font-size: 24rpx;
}

.chip.active {
  color: #fff;
  background: var(--color-brand);
  font-weight: 800;
}

.condition-chip {
  flex: 1;
  text-align: center;
}

.condition-chip.active {
  color: #15803d;
  background: var(--color-brand-soft);
  border: 1rpx solid var(--color-brand);
  font-weight: 800;
}

.location-row,
.switch-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.location-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 18rpx;
  border-radius: var(--radius-sm);
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.location-title {
  font-size: 28rpx;
  font-weight: 900;
}

.location-sub {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.switch-row {
  justify-content: space-between;
}

.switch-row > view {
  flex: 1;
}

.publish-button {
  margin-top: 10rpx;
}

.publish-note {
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}
