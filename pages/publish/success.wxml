<view class="page">
  <view class="success-body">
    <view class="success-mark">
      <view class="halo one"></view>
      <view class="halo two"></view>
      <view class="check">✓</view>
    </view>
    <view class="title">发布成功</view>
    <view class="desc">你的闲置已上架到「北京大学」校区，分享给同学可以更快卖出哦</view>

    <view class="item-card">
      <view class="thumb">{{item.emoji}}</view>
      <view class="item-main">
        <view class="item-title">{{item.title}}</view>
        <view class="price">¥{{item.price}}</view>
      </view>
      <text class="status">{{item.status}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="primary" bindtap="shareItem">↗ 分享给同学</button>
    <button class="secondary" bindtap="viewMine">◎ 查看我的发布</button>
  </view>
</view>
