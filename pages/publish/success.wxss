.success-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  padding: var(--space-5);
  gap: var(--space-3);
  text-align: center;
}

.success-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto;
  border-radius: 52rpx;
  color: var(--color-on-brand);
  background: var(--color-brand);
  font-size: 52rpx;
  font-weight: 800;
}

.success-title {
  font-size: 40rpx;
  font-weight: 800;
}

.success-description {
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.created-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: var(--space-2) 0;
  padding: var(--space-3);
  border-radius: var(--radius-sm);
  background: var(--color-surface-subtle);
  text-align: left;
}

.created-item__image,
.created-item__placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
}

.created-item__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand-soft);
  font-size: 48rpx;
}

.created-item__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.created-item__title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.created-item__price {
  color: var(--color-brand-text);
  font-size: 32rpx;
  font-weight: 800;
}

.created-item__meta {
  color: var(--color-muted);
  font-size: 24rpx;
}
