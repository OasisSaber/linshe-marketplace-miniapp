.profile-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
}

.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: var(--color-on-brand);
  background: var(--color-brand);
  font-size: 38rpx;
  font-weight: 800;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 800;
}

.profile-meta {
  color: var(--color-muted);
  font-size: 24rpx;
}

.profile-verify {
  min-width: 144rpx;
  padding: 0 var(--space-3);
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: var(--space-3) 0;
}

.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-1);
  border-right: 1rpx solid var(--color-border);
}

.profile-stat:last-child {
  border-right: 0;
}

.profile-stat__value {
  font-size: 32rpx;
  font-weight: 800;
}

.profile-stat__label {
  color: var(--color-muted);
  font-size: 22rpx;
}

.profile-section {
  margin-top: var(--space-2);
}

.profile-list {
  overflow: hidden;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--touch-min);
  padding: 0 var(--space-4);
  border-bottom: 1rpx solid var(--color-border);
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-row__label {
  font-size: 27rpx;
  font-weight: 700;
}

.profile-row__action {
  color: var(--color-brand-text);
  font-size: 24rpx;
  font-weight: 700;
}
