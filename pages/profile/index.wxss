@import "../../styles/tokens.wxss";

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
}

.content {
  height: 100vh;
}

.profile-head {
  padding: 36rpx 28rpx 30rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
  text-align: center;
}

.avatar-wrap {
  width: 164rpx;
  height: 132rpx;
  margin: 0 auto;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-brand), var(--color-brand-dark));
  color: #ffffff;
  text-align: center;
  line-height: 1;
  font-size: 52rpx;
  font-weight: 900;
}

.verify {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 150rpx;
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #fef3c7;
  color: var(--color-warn);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.verify.verified {
  background: var(--color-brand-soft);
  color: var(--color-brand);
}

.name {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.school {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.stats {
  display: flex;
  margin-top: 34rpx;
}

.stat {
  flex: 1;
  border-right: 1rpx solid var(--color-border);
}

.stat:last-child {
  border-right: 0;
}

.stat view {
  font-size: 34rpx;
  font-weight: 900;
}

.stat text {
  color: var(--color-muted);
  font-size: 22rpx;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
  padding: 26rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(168deg, var(--color-brand), var(--color-brand-dark));
  color: #ffffff;
}

.member-logo {
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
  border-radius: 18rpx;
}

.member-main {
  flex: 1;
}

.member-title {
  font-size: 28rpx;
  font-weight: 900;
}

.member-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
}

.points {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.points text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
}

.shortcut-card,
.menu-card {
  margin: 24rpx 28rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  background: var(--color-surface);
}

.shortcut-card {
  display: flex;
  flex-wrap: wrap;
}

.shortcut {
  width: 50%;
  height: 176rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-right: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  font-size: 24rpx;
  font-weight: 700;
}

.shortcut:nth-child(2n) {
  border-right: 0;
}

.shortcut:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.shortcut-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-brand-soft);
  color: var(--color-brand);
  text-align: center;
  line-height: 1;
}

.dot {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1;
}

.menu-card {
  margin-bottom: 32rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  height: 108rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #edeef2;
  color: var(--color-muted);
  text-align: center;
  line-height: 1;
}

.menu-label {
  flex: 1;
  font-size: 27rpx;
}

.arrow {
  color: var(--color-muted);
  font-size: 34rpx;
}
