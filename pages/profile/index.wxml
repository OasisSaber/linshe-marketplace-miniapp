<view class="page profile-page">
  <view class="profile-hero surface-card">
    <view class="profile-avatar">邻</view>
    <view class="profile-copy">
      <text class="profile-name">邻舍 Demo 用户</text>
      <text class="profile-meta">{{isVerified ? '已完成 Demo 学生认证' : '尚未完成学生认证'}}</text>
    </view>
    <button
      wx:if="{{!isVerified}}"
      class="button-base button-secondary pressable profile-verify"
      hover-class="pressable--active"
      bindtap="goVerify"
    >去认证</button>
  </view>

  <view class="profile-stats surface-card">
    <view wx:for="{{stats}}" wx:key="label" class="profile-stat">
      <text class="profile-stat__value tabular-nums">{{item.value}}</text>
      <text class="profile-stat__label">{{item.label}}</text>
    </view>
  </view>

  <view class="profile-section">
    <text class="section-title">常用功能</text>
    <view class="profile-list surface-card">
      <view
        wx:for="{{shortcuts}}"
        wx:key="label"
        class="profile-row pressable"
        hover-class="pressable--active"
        data-url="{{item.url}}"
        bindtap="openShortcut"
       role="button">
        <text class="profile-row__label">{{item.label}}</text>
        <text class="profile-row__action">{{item.url ? '查看' : '演示中'}}</text>
      </view>
      <view class="profile-row pressable" hover-class="pressable--active" bindtap="openWallet" role="button">
        <text class="profile-row__label">Demo 钱包</text>
        <text class="profile-row__action">查看</text>
      </view>
    </view>
  </view>
</view>
