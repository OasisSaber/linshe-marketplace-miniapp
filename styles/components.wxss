.pressable {
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: var(--duration-standard);
  transition-timing-function: var(--easing-standard);
}

.pressable--active {
  transform: scale(0.96);
  opacity: 0.9;
}

.is-disabled {
  opacity: 0.48;
  pointer-events: none;
}

.button-base {
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-4);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.button-primary {
  color: var(--color-on-brand);
  background: var(--color-brand);
  box-shadow: var(--shadow-brand);
}

.button-secondary {
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
}

.button-ghost {
  color: var(--color-text-secondary);
  background: transparent;
}

.button-danger {
  color: var(--color-on-brand);
  background: var(--color-danger);
}

.surface-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.field__label {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.field__control {
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text);
  background: var(--color-surface);
  font-size: 28rpx;
}

.field__control--textarea {
  min-height: 192rpx;
  padding-top: var(--space-3);
  padding-bottom: var(--space-3);
  line-height: 1.55;
}

.field__control--error {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
}

.field__helper,
.field__error {
  font-size: 24rpx;
  line-height: 1.45;
}

.field__helper {
  color: var(--color-muted);
}

.field__error {
  color: var(--color-danger);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  font-size: 26rpx;
}

.chip--active {
  border-color: var(--color-brand-border);
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
}

.status-chip {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 var(--space-2);
  border-radius: var(--radius-pill);
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: 96rpx var(--space-4);
  text-align: center;
}

.state-panel__title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.state-panel__description {
  max-width: 560rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.money,
.tabular-nums {
  font-variant-numeric: tabular-nums;
}

.image-outline {
  box-shadow: inset 0 0 0 1rpx var(--color-image-outline);
}
