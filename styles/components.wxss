
.pressable {
  transform-origin: center;
  transition-property: transform, opacity, background-color, border-color, box-shadow;
  transition-duration: var(--duration-fast);
  transition-timing-function: var(--easing-standard);
}

.pressable--active {
  transform: scale(0.98);
  opacity: 0.82;
}

.is-disabled {
  opacity: 0.42;
  pointer-events: none;
}

.button-base {
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-4);
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1;
}

.button-primary {
  color: var(--color-on-brand);
  background: var(--color-brand);
  box-shadow: var(--shadow-brand);
}

.button-secondary {
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
}

.button-plain,
.button-ghost {
  color: var(--color-brand-text);
  background: transparent;
}

.button-danger {
  color: var(--color-danger);
  background: var(--color-danger-soft);
}

.surface-card {
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.inset-group {
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.inset-row {
  display: flex;
  align-items: center;
  min-height: var(--control-large);
  box-sizing: border-box;
  padding: 0 var(--space-4);
}

.inset-row + .inset-row {
  border-top: 1rpx solid var(--color-border);
}

.section-label {
  display: block;
  margin: 0 var(--space-2) var(--space-2);
  color: var(--color-muted);
  font-size: var(--font-footnote);
  font-weight: 600;
  letter-spacing: 0.2rpx;
  line-height: 1.35;
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.field__label {
  color: var(--color-text);
  font-size: var(--font-body);
  font-weight: 600;
  line-height: 1.35;
}

.field__control {
  min-height: var(--control-large);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-control);
  color: var(--color-text);
  background: var(--color-surface);
  font-size: var(--font-body);
  transition-property: border-color, background-color, box-shadow;
  transition-duration: var(--duration-standard);
  transition-timing-function: var(--easing-standard);
}

.field__control--textarea {
  min-height: 216rpx;
  padding-top: var(--space-3);
  padding-bottom: var(--space-3);
  line-height: 1.55;
}

.field__control--error {
  border-color: var(--color-danger-border);
  background: var(--color-danger-soft);
}

.field__helper,
.field__error {
  font-size: var(--font-footnote);
  line-height: 1.45;
}

.field__helper {
  color: var(--color-muted);
}

.field__error {
  color: var(--color-danger);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-min);
  box-sizing: border-box;
  padding: 0 var(--space-3);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  font-size: 26rpx;
  font-weight: 500;
}

.chip--active {
  border-color: var(--color-brand-border);
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-weight: 600;
}

.status-chip {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  box-sizing: border-box;
  padding: 0 var(--space-2);
  border-radius: var(--radius-pill);
  color: var(--color-brand-text);
  background: var(--color-brand-soft);
  font-size: var(--font-caption);
  font-weight: 600;
}

.feedback-banner {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3) var(--space-4);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
}

.feedback-banner--danger {
  border-color: var(--color-danger-border);
  background: var(--color-danger-soft);
}

.feedback-banner--warning {
  border-color: var(--color-warning-border);
  background: var(--color-warning-soft);
}

.feedback-banner--info {
  border-color: var(--color-info-border);
  background: var(--color-info-soft);
}

.feedback-banner__title {
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.feedback-banner__description {
  color: var(--color-text-secondary);
  font-size: var(--font-footnote);
  line-height: 1.5;
}

.state-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: 112rpx var(--space-4);
  text-align: center;
}

.state-panel__title {
  color: var(--color-text);
  font-size: var(--font-title-3);
  font-weight: 700;
  line-height: 1.25;
}

.state-panel__description {
  max-width: 560rpx;
  color: var(--color-muted);
  font-size: var(--font-body);
  line-height: 1.55;
}

.bottom-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: var(--space-2) var(--space-4) calc(var(--space-2) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  background: var(--color-surface-elevated);
  box-shadow: var(--shadow-bottom-bar);
}

.money,
.tabular-nums {
  font-variant-numeric: tabular-nums;
}

.image-outline {
  box-shadow: inset 0 0 0 1rpx var(--color-image-outline);
}
